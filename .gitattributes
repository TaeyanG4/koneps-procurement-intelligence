# Line ending control for cross-platform reproducibility
# Text files: stored as LF, checked out as-is on all platforms
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.sh text eol=lf
*.env text eol=lf

# Binary files: no line-ending transformation
*.docx binary
*.parquet binary
*.gz binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
