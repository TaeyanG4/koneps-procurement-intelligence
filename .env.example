# KONEPS Procurement Intelligence - Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to Git.

# -------------------------------------------------------
# API Authentication
# Purpose: Authenticate against Korea Public Data Portal OpenAPI.
# Obtain your key at: https://www.data.go.kr/
# -------------------------------------------------------
DATA_GO_KR_SERVICE_KEY=your_data_go_kr_service_key_here

# -------------------------------------------------------
# Supplier Pseudonymization Secret (SEPARATE from API key)
# Purpose: Stable HMAC-SHA256 secret for generating supplier public IDs.
# IMPORTANT: This key must NEVER change after a dataset version is published.
# Changing it would invalidate all previously issued supplier IDs.
# Generate with: python -c import secrets; print(secrets.token_hex(32))
# -------------------------------------------------------
KONEPS_SUPPLIER_HMAC_KEY=your_32_or_more_char_random_secret_here
